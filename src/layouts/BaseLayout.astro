---
/**
 * The layout of every page: the head (language, title, description, the
 * metadata for search engines and social networks, font, theme script, icons,
 * and what the page adds in its `head` slot), a skip link, the header and
 * footer shells, and the page's content in <main>, where each section sets
 * its own width. The page's route comes from its path, which must be in
 * src/i18n/routes.ts in the page's language, or the build fails.
 */
import { Font } from "astro:assets";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import Seo from "../components/layout/Seo.astro";
import ThemeScript from "../components/layout/ThemeScript.astro";
import { translations } from "../i18n";
import { pageLocale } from "../i18n/config";
import { routeOf } from "../i18n/routes";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const locale = pageLocale(Astro.currentLocale);
const route = routeOf(Astro.url.pathname);
if (route.locale !== locale) {
  throw new Error(
    `${Astro.url.pathname} is the ${route.locale} path of "${route.key}", but the page is in ${locale}`,
  );
}
const t = translations(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Seo route={route} title={title} description={description} />
    <ThemeScript />
    <Font cssVariable="--font-outfit" preload />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#content"
      class="sr-only rounded-pill bg-primary px-5 py-3 font-medium text-primary-text focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
      >{t.layout.skipLink}</a
    >
    <Header route={route} />
    <main id="content" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer route={route} />
  </body>
</html>
