---
/**
 * A link styled as a button (the brand's design system): primary (mint, with
 * a glow), ghost (gold outline) or text (mint, with an arrow), in two sizes.
 * Its focus ring is the site's (global.css). A link to another site shows an
 * external-link icon and says so to screen readers (`externalHint`). A
 * leading icon (GitHub, play) may come before the label. Without `href`, it
 * is a form's submit button.
 */
import "../../styles/button.css";
import Icon from "./Icon.astro";

interface Props {
  /** The link's address; without one, a submit button. */
  href?: string;
  variant: "primary" | "ghost" | "text";
  size?: "md" | "sm";
  icon?: "arrow" | "external";
  leadingIcon?: "github" | "play";
  /** For a link to another site: the hidden words that say so. */
  externalHint?: string;
  /** For a link in a navigation: its `aria-current` mark. */
  current?: "page" | "true" | undefined;
  class?: string;
}

const {
  href,
  variant,
  size = "md",
  icon,
  leadingIcon,
  externalHint,
  current,
  class: className,
} = Astro.props;
const Tag = href === undefined ? "button" : "a";
const attributes =
  href === undefined ? { type: "submit" as const } : { href, "aria-current": current };
---

<Tag {...attributes} class:list={["button", `button-${variant}`, `button-${size}`, className]}>
  {leadingIcon !== undefined && <Icon name={leadingIcon} size={size === "sm" ? 16 : 18} />}
  <slot />
  {externalHint !== undefined && <span class="sr-only">({externalHint})</span>}
  {icon !== undefined && <Icon name={icon} size={icon === "external" || size === "sm" ? 16 : 18} />}
</Tag>
