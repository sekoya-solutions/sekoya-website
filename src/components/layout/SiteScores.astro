---
/**
 * The footer's "this site, measured" column (ADR 0007): the site's mobile
 * Lighthouse figure in each category, each in a ring, with the measurement
 * date, read from src/data/lighthouse.json. With no file, it says the
 * measurement is pending and shows no number. Then the framework, and a link
 * to the site's source code.
 */

import { translations } from "../../i18n";
import { pageLocale } from "../../i18n/config";
import { project } from "../../i18n/content";
import { numericDate } from "../../lib/dates";
import { categories, scoreTier } from "../../lib/lighthouse";
import { siteMeasurement } from "../../lib/site-measurement";
import Icon from "../ui/Icon.astro";

const locale = pageLocale(Astro.currentLocale);
const t = translations(locale).layout.scores;
const { repo } = (await project(locale, "sekoya-website")).data;
const measurement = siteMeasurement;
---

<div class="site-scores">
  <p id="site-scores-title" class="site-scores-title">{t.title}</p>
  <p class="site-scores-label">
    {t.source} ·{" "}
    {
      measurement === undefined ? (
        t.pending
      ) : (
        <time datetime={measurement.measuredOn}>{numericDate(measurement.measuredOn)}</time>
      )
    }
  </p>
  {
    measurement !== undefined && (
      <ul class="site-scores-list" aria-labelledby="site-scores-title">
        {categories.map((category) => {
          const value = measurement.summary[category];
          return (
            <li class="site-score" data-category={category} data-tier={scoreTier(value)}>
              <span class="site-score-ring">
                <svg viewBox="0 0 36 36" aria-hidden="true">
                  <circle class="site-score-track" cx="18" cy="18" r="16" />
                  <circle
                    class="site-score-arc"
                    cx="18"
                    cy="18"
                    r="16"
                    pathLength="100"
                    stroke-dasharray={`${value} 100`}
                  />
                </svg>
                <span class="site-score-value">{value}</span>
              </span>
              <span aria-hidden="true">{t.categories[category]}</span>
              <span class="sr-only">{t.categoryNames[category]}</span>
            </li>
          );
        })}
      </ul>
    )
  }
  <p class="site-scores-built">
    {t.builtWith} <strong>Astro</strong> ·{" "}
    <a href={repo} class="site-scores-link">
      {t.sourceCode}
      <span class="sr-only">({t.externalLink})</span>
      <Icon name="external" size={13} />
    </a>
  </p>
</div>

<style>
  .site-scores {
    display: grid;
    gap: 12px;
    justify-items: start;
  }

  .site-scores-title {
    color: var(--ink);
    font-weight: 600;
  }

  .site-scores-label {
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .site-scores-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }

  .site-score {
    display: grid;
    justify-items: center;
    gap: 6px;
    font-size: var(--fs-xs);
  }

  .site-score-ring {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }

  .site-score-ring > * {
    grid-area: 1 / 1;
  }

  .site-score-ring svg {
    width: 100%;
    height: 100%;
    /* The arc starts at the top and runs clockwise. */
    transform: rotate(-90deg);
  }

  .site-score-track,
  .site-score-arc {
    fill: none;
    stroke-width: 3;
  }

  .site-score-track {
    stroke: var(--line-strong);
  }

  .site-score-arc {
    stroke: var(--mint);
    stroke-linecap: round;
  }

  [data-tier="average"] .site-score-arc {
    stroke: var(--gold);
  }

  [data-tier="poor"] .site-score-arc {
    stroke: var(--danger);
  }

  .site-score-value {
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .site-scores-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-scores-link:hover {
    color: var(--ink);
  }
</style>
