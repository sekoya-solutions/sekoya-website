# Optional variables. None is needed to build the site. Real values live in
# Cloudflare's environment variables (ADR 0002), never in the repository.

# The HTTPS address the contact form posts to; the form is rendered only when
# it is set (ADR 0008). The build fails while the legal notice does not name
# the service that receives the messages (src/lib/contact-form.ts).
PUBLIC_CONTACT_FORM_ACTION=

# 1 on previews, to allow `[TODO: ...]` placeholders in a build (ADR 0007).
ALLOW_TODO=
