---
/**
 * The home page, in the page's language: src/pages/index.astro in French and
 * src/pages/en/index.astro in English. Its sections come with #9 and #10.
 */
import { translations } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";

const t = translations(Astro.currentLocale);
---

<BaseLayout title={t.home.title} description={t.home.description}>
  <h1 class="py-16 text-h1 leading-[1.08] font-bold tracking-[-0.02em]">Sekoya Solutions</h1>
</BaseLayout>
