---
/**
 * The career page (#18), in the page's language: src/pages/parcours.astro in
 * French and src/pages/en/career.astro in English. Its copy and positions are
 * in src/content/career.
 *
 * The source of truth is the list of positions, the most recent first: a
 * vertical timeline whose cards open (`<details>`) on their highlights and
 * stack. It is always in the page. From 1024 px wide, with scripting, the
 * trunk's rings (TreeRings.astro) show instead, beside the panel of the
 * pinned position, with the legend in one row under both, and the list is
 * only kept for screen readers. Without scripting, or below 1024 px, the
 * timeline shows (ADR 0005, ADR 0010).
 *
 * The ring is sized on both the width and the height, so the rings and the
 * legend fit on one screen. The page scrolls normally: once the stage comes
 * into view, the rings draw themselves in once, from the pith outwards, as a
 * CSS animation takes the progress, `--career-p`, from 0 to 1; the script
 * (career-rings.ts) only says when to start. Under reduced motion, or if the
 * script does not run, the rings are drawn in full at once.
 */
import { translations } from "../../i18n";
import { pageLocale } from "../../i18n/config";
import { careerContent } from "../../i18n/content";
import { caseStudyKey, isRouteKey, pathOf } from "../../i18n/routes";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderText from "../content/PlaceholderText.astro";
import Button from "../ui/Button.astro";
import Chip from "../ui/Chip.astro";
import { careerRingsHash, careerRingsScript } from "./career-rings";
import { careerView, ringStyles, styleHash } from "./career-view";
import TreeRings from "./TreeRings.astro";

const locale = pageLocale(Astro.currentLocale);
const t = translations(locale);
const copy = await careerContent(locale);
const { labels, initial } = copy;
const positions = careerView(copy.positions, labels, locale);
/** The legend reads as the rings grow: from the pith outwards. */
const oldestFirst = [...positions].reverse();
const caseStudyHref = (slug: string | undefined) => {
  if (slug === undefined) return undefined;
  const key = caseStudyKey(slug);
  return isRouteKey(key) ? pathOf(key, locale) : undefined;
};
const css = ringStyles(positions);
if (Astro.csp === undefined) throw new Error("astro.config.mjs must enable the CSP");
Astro.csp.insertStyleHash(styleHash(css));
Astro.csp.insertScriptHash(careerRingsHash);
---

<BaseLayout title={t.career.title} description={t.career.description}>
  <style slot="head" is:inline set:html={css}></style>
  <div class="career-page">
    <div class="career-head mx-auto max-w-site px-(--gutter)">
      <div>
        <p class="eyebrow"><PlaceholderText text={copy.eyebrow} /></p>
        <h1 class="career-title mt-3.5 font-bold tracking-[-0.02em]">
          <PlaceholderText text={copy.title} />
        </h1>
      </div>
      <p class="career-lead head-lead">
        <PlaceholderText text={copy.lead} />
      </p>
    </div>

    <div class="career mx-auto max-w-site-wide px-(--gutter)" data-career>
      <ol class="timeline" aria-label={labels.list}>
        {
          positions.map((position) => (
            <li class:list={["timeline-item", { current: position.current }]}>
              <details class="timeline-card">
                <summary>
                  <span class="timeline-node" aria-hidden="true" />
                  <span class="timeline-company">{position.company}</span>
                  <span class="timeline-meta">
                    <PlaceholderText text={position.role} /> ·{" "}
                    <PlaceholderText text={position.period} />
                  </span>
                </summary>
                <div class="timeline-body">
                  <ul class="highlights">
                    {position.highlights.map((highlight) => (
                      <li>
                        <span><PlaceholderText text={highlight} /></span>
                      </li>
                    ))}
                  </ul>
                  <ul class="flex flex-wrap gap-1.5">
                    {position.stack.map((item) => (
                      <li>
                        <Chip>{item}</Chip>
                      </li>
                    ))}
                  </ul>
                  {caseStudyHref(position.caseStudy) !== undefined && (
                    <Button href={caseStudyHref(position.caseStudy)} variant="text" size="sm" icon="arrow">
                      {labels.readCaseStudy}
                    </Button>
                  )}
                </div>
              </details>
            </li>
          ))
        }
      </ol>

      <div class="stage" data-career-stage>
        <div class="stage-pin">
        <div class="stage-figure">
          <TreeRings positions={positions} initial={initial} label={labels.rings} />
        </div>
        <div class="stage-side">
          <p class="career-lead stage-lead">
            <PlaceholderText text={copy.lead} />
          </p>
          <div id="career-panel" class="card panel">
            {
              positions.map((position) => (
                <div class="panel-view" data-panel={position.slug} hidden={position.slug !== initial}>
                  <p class="eyebrow">{labels.selected}</p>
                  <h2 class="panel-company">{position.company}</h2>
                  <p class="panel-role">
                    <PlaceholderText text={position.role} /> · <PlaceholderText text={position.summary} />
                  </p>
                  <p class="panel-chips">
                    <Chip variant="mint">
                      <PlaceholderText text={position.period} />
                    </Chip>
                    {position.duration !== undefined && <Chip>{position.duration}</Chip>}
                    <Chip>{position.ringNumber}</Chip>
                  </p>
                  <ul class="highlights panel-highlights">
                    {position.highlights.map((highlight) => (
                      <li>
                        <span><PlaceholderText text={highlight} /></span>
                      </li>
                    ))}
                  </ul>
                  <ul class="panel-stack">
                    {position.stack.map((item) => (
                      <li>
                        <Chip>{item}</Chip>
                      </li>
                    ))}
                  </ul>
                  {caseStudyHref(position.caseStudy) !== undefined && (
                    <Button href={caseStudyHref(position.caseStudy)} variant="ghost" size="sm" icon="arrow">
                      {labels.readCaseStudy}
                    </Button>
                  )}
                </div>
              ))
            }
          </div>
        </div>
          <ul class="legend" aria-label={labels.legend}>
            {
              oldestFirst.map((position) => (
                <li>
                  <button
                    type="button"
                    class:list={["legend-item", { current: position.current, pinned: position.slug === initial }]}
                    aria-pressed={position.slug === initial ? "true" : "false"}
                    aria-controls="career-panel"
                    data-select={position.slug}
                    data-ring={position.slug}
                  >
                    <span class="legend-swatch" aria-hidden="true" />
                    <span class="legend-company">{position.company}</span>
                    <span class="legend-meta sr-only">
                      <PlaceholderText text={position.role} /> · <PlaceholderText text={position.period} />
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
  <script is:inline set:html={careerRingsScript}></script>
</BaseLayout>

<style>
  /* The progress of the rings' drawing: 1, fully drawn, unless the drawing
     animation below runs. */
  @property --career-p {
    syntax: "<number>";
    inherits: true;
    initial-value: 1;
  }

  /* The trunk's colours (#18): dark wood on the dark theme, as the brand's
     mockup; light sand wood on the light theme, with no navy, its edges in
     deep gold and its year lines in slate. */
  .career {
    margin-top: 32px;
    --wood-disc-in: #12323a;
    --wood-disc-out: #0a1d24;
    --wood-old: #0c232a;
    --wood-new: #123240;
    --wood-current: #14403f;
    --wood-edge: var(--gold);
    --wood-line: var(--grey);
    --wood-line-opacity: 0.16;
    --wood-hot: var(--mint);
    --wood-pith-in: #e8d3a8;
    --wood-pith-out: #b79f6e;
    --wood-bark: var(--gold);
    --wood-bark-opacity: 0.3;
    --wood-label: var(--grey);
    --wood-label-hot: var(--mint);
  }

  :global(:root[data-theme="light"]) .career {
    --wood-disc-in: #efe6d3;
    --wood-disc-out: #e4d7bd;
    --wood-old: #dccdaf;
    --wood-new: #ece3d1;
    --wood-current: #dbe9dc;
    --wood-edge: var(--accent);
    --wood-line: var(--grey);
    --wood-line-opacity: 0.2;
    --wood-hot: var(--mint);
    --wood-pith-in: #c9ad6e;
    --wood-pith-out: #a8893f;
    --wood-bark: var(--accent);
    --wood-bark-opacity: 0.45;
    --wood-label: var(--grey);
    --wood-label-hot: var(--link);
  }

  .career-page {
    padding-top: 32px;
    padding-bottom: 72px;
  }

  .career-head {
    display: grid;
    gap: 18px;
  }

  .career-title {
    font-size: var(--fs-h1);
    line-height: 1.08;
  }

  /* A placeholder in the title, set in the title's large size, may wrap: kept
     on one line, it would be wider than a phone. */
  .career-title :global(.placeholder) {
    white-space: normal;
  }

  .career-lead {
    max-width: 24rem;
    color: var(--muted);
    font-size: 1.02rem;
    font-weight: 300;
    line-height: 1.6;
  }

  /* How to read the rings, shown with them, above the panel: the copy is
     written twice, and only one shows at a time, so it is read once. */
  .stage-lead {
    display: none;
    max-width: none;
    margin-bottom: 14px;
  }

  /* The vertical timeline: a line from mint to faded gold, and a card per
     position with a double-ring node; the current position's node glows. */
  .timeline {
    position: relative;
    display: grid;
    gap: 14px;
    max-width: 40rem;
    padding-left: 34px;
  }

  .timeline::before {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 11px;
    width: 2px;
    background: linear-gradient(var(--mint), var(--gold) 60%, rgb(232 211 168 / 0.2));
    content: "";
  }

  .timeline-card {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: rgb(14 38 47 / 0.7);
  }

  :global(:root[data-theme="light"]) .timeline-card {
    background: var(--surface-1);
  }

  .timeline-card summary {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: var(--r-md);
    cursor: pointer;
    list-style: none;
  }

  .timeline-card summary::-webkit-details-marker {
    display: none;
  }

  .timeline-node {
    position: absolute;
    top: 15px;
    left: -31px;
    width: 16px;
    height: 16px;
    box-sizing: border-box;
    border: 3px double var(--gold);
    border-radius: 50%;
    background: var(--bg);
  }

  .timeline-item.current .timeline-node {
    border-color: var(--mint);
    box-shadow: 0 0 10px var(--mint);
  }

  .timeline-company {
    font-weight: 600;
  }

  .timeline-meta {
    color: var(--muted);
    font-size: var(--fs-xs);
  }

  .timeline-body {
    display: grid;
    gap: 14px;
    justify-items: start;
    padding: 0 14px 16px;
  }

  .highlights {
    display: grid;
    gap: 10px;
  }

  .highlights li {
    display: grid;
    grid-template-columns: 8px 1fr;
    gap: 12px;
    line-height: 1.5;
  }

  .highlights li::before {
    width: 8px;
    height: 8px;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
    content: "";
  }

  .timeline .highlights {
    font-size: var(--fs-sm);
  }

  /* The rings' stage: hidden until the rings can work (scripting, 1024 px). */
  .stage {
    display: none;
  }

  .panel {
    padding: 28px 24px;
  }

  .panel-company {
    margin: 8px 0 4px;
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .panel-role {
    color: var(--muted);
    font-size: 1.05rem;
  }

  .panel-chips,
  .panel-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .panel-chips {
    margin: 14px 0 22px;
  }

  .panel-highlights {
    margin-bottom: 22px;
    font-size: 0.98rem;
  }

  .panel-stack {
    gap: 6px;
    margin-bottom: 24px;
  }

  /* The legend: a compact chip per position, its swatch and company; the
     role and period, in the panel and the tooltip, are only read aloud. */
  .legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .legend-item {
    display: grid;
    grid-template-columns: 14px 1fr;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 9px 12px;
    column-gap: 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(14 38 47 / 0.5);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition:
      border-color 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }

  :global(:root[data-theme="light"]) .legend-item {
    background: var(--surface-1);
  }

  .legend-item:is(:hover, .hot, .pinned) {
    border-color: rgb(34 192 138 / 0.55);
    box-shadow: var(--glow-mint);
  }

  .legend-swatch {
    width: 14px;
    height: 14px;
    box-sizing: border-box;
    border: 2px solid var(--gold);
    border-radius: 50%;
  }

  .legend-item.current .legend-swatch {
    border-style: dashed;
    border-color: var(--mint);
  }

  .legend-item.pinned .legend-swatch {
    border-color: var(--mint);
    background: rgb(34 192 138 / 0.3);
  }

  .legend-company {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.25;
  }

  @media (width >= 64rem) {
    .career-page {
      padding-top: 40px;
      padding-bottom: 96px;
    }

    .career-head {
      grid-template-columns: 1fr auto;
      gap: 40px;
      align-items: end;
    }

    /* The panel grows with the screen, from compact beside the ring at
       1024 px to its full size from about 1420 px. */
    .panel {
      padding: clamp(24px, 2.4vw, 34px) clamp(24px, 2.4vw, 34px) clamp(22px, 2.1vw, 30px);
    }

    .panel-company {
      font-size: clamp(1.6rem, 1rem + 0.9vw, 1.9rem);
    }
  }

  /* From 1024 px, with scripting, the rings and the panel side by side, and
     the legend in one row under both. The ring is at most 700 px and leaves
     11rem of the screen's height for the legend and the margins, so the
     rings and the legend show together; it never goes below 20rem. The panel
     keeps at least 28rem beside it, so on a narrow screen it wraps less and
     is no taller than the ring and the legend leave room for. */
  @media (scripting: enabled) and (width >= 64rem) {
    .stage {
      display: block;
    }

    .head-lead {
      display: none;
    }

    .stage-lead {
      display: block;
    }

    .stage-pin {
      --ring-size: min(700px, max(20rem, 100dvh - 11rem));

      display: grid;
      grid-template-columns: minmax(0, var(--ring-size)) minmax(28rem, 1fr);
      gap: 24px 44px;
      align-items: start;
    }

    .stage-figure > :global(.rings-figure) {
      width: min(100%, var(--ring-size));
      margin-inline: auto;
    }

    .legend {
      grid-column: 1 / -1;
      grid-template-columns: none;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
    }

    /* Kept for screen readers only; shown again if it ever takes the focus. */
    .timeline:not(:focus-within) {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* On a short screen (under 720 px tall), the side column is tightened, so
     the tallest panel is no taller than the ring, and the legend still shows
     under both. */
  @media (scripting: enabled) and (width >= 64rem) and (height < 45rem) {
    .stage-lead {
      margin-bottom: 10px;
      font-size: var(--fs-sm);
      line-height: 1.5;
    }

    .panel {
      padding: 22px 26px 20px;
    }

    .panel-company {
      font-size: 1.6rem;
    }

    .panel-chips {
      margin: 10px 0 14px;
    }

    .panel-highlights {
      gap: 6px;
      margin-bottom: 14px;
    }

    .panel-stack {
      margin-bottom: 16px;
    }
  }

  /* The drawing, once, with motion: the script marks the stage `pending` as
     it starts, so the rings wait undrawn, then `run` once the stage comes
     into view. With no script, or under reduced motion, neither applies and
     the rings are drawn in full. */
  @media (prefers-reduced-motion: no-preference) {
    .stage[data-draw="pending"] {
      --career-p: 0;
    }

    .stage[data-draw="run"] {
      animation: career-draw 2.5s linear both;
    }
  }

  @keyframes career-draw {
    from {
      --career-p: 0;
    }

    to {
      --career-p: 1;
    }
  }
</style>
