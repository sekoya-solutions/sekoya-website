---
/**
 * The header shell: the logo, linking to the home page in the page's
 * language, the language switch and the theme toggle. The navigation comes
 * with its pages.
 */
import { type PageRoute, pathOf } from "../../i18n/routes";
import Logo from "../brand/Logo.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  route: PageRoute;
}

const { route } = Astro.props;
---

<header class="mx-auto flex h-21 max-w-site items-center justify-between px-(--gutter)">
  <a href={pathOf("home", route.locale)} class="-ml-2.5 rounded-md">
    <Logo class="h-14 w-auto" />
  </a>
  <div class="flex items-center gap-3">
    <LanguageSwitch route={route} />
    <ThemeToggle />
  </div>
</header>
