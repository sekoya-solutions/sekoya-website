---
/**
 * A small pill label: neutral, mint or gold. Chips do not move or glow.
 */
interface Props {
  variant?: "neutral" | "mint" | "gold";
  class?: string;
}

const { variant = "neutral", class: className } = Astro.props;
---

<span class:list={["chip", `chip-${variant}`, className]}><slot /></span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 11px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.4;
    white-space: nowrap;
  }

  .chip-mint {
    border-color: rgb(34 192 138 / 0.4);
    background: rgb(34 192 138 / 0.07);
    color: var(--link);
  }

  .chip-gold {
    border-color: rgb(232 211 168 / 0.4);
    background: rgb(232 211 168 / 0.06);
    color: var(--gold);
  }

  /* Deep gold is for strokes only on sand: the text stays ink. */
  :global(:root[data-theme="light"]) .chip-gold {
    border-color: var(--accent);
    background: rgb(168 137 63 / 0.08);
    color: var(--ink);
  }

  :global(:root[data-theme="light"]) .chip-mint {
    border-color: rgb(15 107 90 / 0.4);
    background: rgb(15 107 90 / 0.06);
  }
</style>
