---
/**
 * A home section's heading: its eyebrow, then its title, an h2 whose id
 * names the section (`aria-labelledby`).
 */
import PlaceholderText from "../content/PlaceholderText.astro";

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  class?: string;
}

const { id, eyebrow, title, class: className } = Astro.props;
---

<div class:list={["reveal mb-8 flex max-w-[900px] flex-col gap-3.5 lg:mb-12", className]}>
  <p class="eyebrow"><PlaceholderText text={eyebrow} /></p>
  <h2 id={id} class="text-h2 leading-[1.12] font-bold tracking-[-0.015em]">
    <PlaceholderText text={title} />
  </h2>
</div>
