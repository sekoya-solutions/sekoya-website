---
/**
 * An offer's card: its icon, title, typical duration, who it is for, what
 * the client gets, and its call to action once that page exists. The card's
 * id is its anchor.
 *
 * From 1024 px the card is a subgrid of the offers list's six rows (see
 * Offers.astro), so its parts line up with the other cards' parts. Below,
 * the cards stack and each lays out its own rows.
 */
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../i18n/config";
import { linkHref } from "../../i18n/routes";
import PlaceholderText from "../content/PlaceholderText.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

type Copy = CollectionEntry<"offers">["data"];

interface Props {
  offer: Copy["items"][number];
  labels: Copy["labels"];
  locale: Locale;
}

const { offer, labels, locale } = Astro.props;
const { action } = offer;
const href = linkHref(action, locale);
---

<li id={offer.id} class="card offer reveal">
  <svg class="offer-circuit" viewBox="0 0 190 190" aria-hidden="true">
    <path d="M190 40 H120 L96 64 V130"></path>
    <path d="M190 90 H140 L120 110 V170"></path>
    <path d="M190 140 H160 L146 154 V190"></path>
    <circle cx="96" cy="136" r="5"></circle>
    <circle cx="120" cy="176" r="5"></circle>
    <circle cx="146" cy="194" r="5"></circle>
  </svg>
  <span class="offer-icon">
    <Icon name={offer.icon} size={28} />
  </span>
  <h2 id={`${offer.id}-title`} class="offer-title">
    <PlaceholderText text={offer.title} />
  </h2>
  <p class="offer-duration">
    <Icon name="clock" size={18} />
    <span><PlaceholderText text={offer.duration} /></span>
  </p>
  <div>
    <h3 class="offer-label">
      <PlaceholderText text={labels.forWho} />
    </h3>
    <p class="offer-for"><PlaceholderText text={offer.forWho} /></p>
  </div>
  <div>
    <h3 class="offer-label">
      <PlaceholderText text={labels.deliverables} />
    </h3>
    <ul class="offer-deliverables">
      {
        offer.deliverables.map((deliverable) => (
          <li>
            <Icon name="check" size={18} class="offer-check" />
            <span>
              <PlaceholderText text={deliverable} />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
  {
    href !== undefined && (
      <div class="offer-foot">
        <Button href={href} variant={action.variant} size="sm" icon="arrow">
          {action.label}
        </Button>
      </div>
    )
  }
</li>

<style>
  .offer {
    display: grid;
    align-content: start;
    padding: 28px 24px 26px;
    scroll-margin-top: 24px;
  }

  /* A mint rule along the top edge, fading out to the right. */
  .offer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--mint), transparent);
  }

  /* A fragment of circuit in the top-right corner, behind the content. */
  .offer-circuit {
    position: absolute;
    top: -10px;
    right: -30px;
    width: 190px;
    height: 190px;
    fill: var(--grey);
    stroke: var(--grey);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    opacity: 0.32;
    pointer-events: none;
  }

  .offer-circuit path {
    fill: none;
  }

  .offer-icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    margin-bottom: 22px;
    border: 1px solid rgb(34 192 138 / 0.5);
    border-radius: 16px;
    box-shadow: var(--glow-mint);
    color: var(--mint);
  }

  .offer-title {
    position: relative;
    align-self: start;
    margin-bottom: 12px;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .offer-duration {
    display: inline-flex;
    align-items: center;
    align-self: start;
    gap: 8px;
    margin-bottom: 22px;
    color: var(--gold);
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* Deep gold is for strokes only on sand: the text stays ink. */
  :global(:root[data-theme="light"]) .offer-duration {
    color: var(--ink);
  }

  :global(:root[data-theme="light"]) .offer-duration :global(svg) {
    color: var(--accent);
  }

  .offer-label {
    margin-bottom: 10px;
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .offer-for {
    margin-bottom: 24px;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.55;
  }

  .offer-deliverables {
    display: grid;
    gap: 11px;
    margin-bottom: 28px;
  }

  .offer-deliverables li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    font-size: 0.97rem;
    line-height: 1.45;
  }

  .offer-deliverables :global(.offer-check) {
    margin-top: 2px;
    color: var(--mint);
  }

  .offer-foot {
    align-self: end;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 64rem) {
    .offer {
      grid-row: span 6;
      grid-template-rows: subgrid;
      row-gap: 0;
      padding: 38px 34px 34px;
    }

    .offer-icon {
      margin-bottom: 26px;
    }

    .offer-title {
      margin-bottom: 14px;
      font-size: 1.75rem;
    }

    .offer-deliverables {
      margin-bottom: 30px;
    }
  }
</style>
