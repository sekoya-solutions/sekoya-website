---
/**
 * A text from the content, with each `[TODO: …]` placeholder (ADR 0007)
 * shown as a chip (`.placeholder`, src/styles/global.css): dashed,
 * monospace, so it can never pass for a fact.
 */
import { splitPlaceholders } from "../../lib/placeholders";

interface Props {
  text: string;
}

const parts = splitPlaceholders(Astro.props.text);
---

{parts.map((part) => (part.placeholder ? <span class="placeholder">{part.text}</span> : part.text))}
