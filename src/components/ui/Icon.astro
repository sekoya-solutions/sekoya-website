---
/**
 * The line icons of the site, drawn on a 24-unit grid with the current text
 * colour. They are decorative: the text next to them carries the meaning.
 */
interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}

const icons = {
  arrow: { stroke: 2, body: '<path d="M5 12h14M13 6l6 6-6 6"/>' },
  external: {
    stroke: 1.8,
