---
/**
 * The theme toggle: a button pressed when the light theme is on. The theme
 * script wires it. Without scripting it would do nothing, so it is hidden.
 * The sun shows in the dark theme, the moon in the light one.
 */
import { translations } from "../../i18n";

const t = translations(Astro.currentLocale);
---

<button
  type="button"
  class="theme-toggle grid size-11 cursor-pointer place-items-center rounded-pill border border-line-strong text-grey"
  aria-pressed="false"
  data-theme-toggle
>
  <span class="sr-only">{t.layout.lightTheme}</span>
  <svg
    class="theme-toggle-sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2.5V5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"
    ></path>
  </svg>
  <svg
    class="theme-toggle-moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  .theme-toggle-moon,
  :root[data-theme="light"] .theme-toggle-sun {
    display: none;
  }

  :root[data-theme="light"] .theme-toggle-moon {
    display: block;
  }

  @media (scripting: none) {
    .theme-toggle {
      display: none;
    }
  }
</style>
