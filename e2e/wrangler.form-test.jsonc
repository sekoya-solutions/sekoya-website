// The test build with the contact form on (scripts/form-test.ts), served by
// `wrangler dev` for the end-to-end tests only: never deployed. The same
// settings as wrangler.jsonc, on the test build's folder.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sekoya-website-form-test",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "../dist-form",
    "html_handling": "drop-trailing-slash"
  }
}
