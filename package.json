{
  "name": "sekoya-website",
  "version": "0.0.0",
  "private": true,
  "description": "Source of the Sekoya Solutions website, a static site built with Astro.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "biome check && astro check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:install": "node scripts/playwright-install.ts",
    "lint:md": "node scripts/markdown.ts lint",
    "links:md": "node scripts/markdown.ts links"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "astro": "7.4.13",
    "markdownlint-cli2": "0.24.2",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
