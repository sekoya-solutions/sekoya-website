---
/**
 * The home hero: the copy on the left and the growing logo's scene behind it
 * on the right (HeroScene.astro), from 1024 px wide; below that, the scene
 * above the copy. The trust line and the scroll hint show from 1024 px only,
 * as in the mobile mockup. From 1024 px the header overlays the hero.
 *
 * The heading is the page's Largest Contentful Paint element: it is opaque
 * from the first paint and only rises into place. The other lines fade up,
 * 100 ms apart, and nothing waits for the logo. A button is shown only once
 * its page exists in the route map.
 */
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../i18n/config";
import { isRouteKey, pathOf } from "../../i18n/routes";
import PlaceholderText from "../content/PlaceholderText.astro";
import Button from "../ui/Button.astro";
import HeroScene from "./HeroScene.astro";

interface Props {
  copy: CollectionEntry<"home">["data"]["hero"];
  locale: Locale;
}

const { copy, locale } = Astro.props;
const actions = copy.actions.flatMap(({ label, page, variant }) =>
  isRouteKey(page) ? [{ label, variant, href: pathOf(page, locale) }] : [],
);
---

<section class="hero relative overflow-hidden lg:-mt-21 lg:min-h-[650px]" aria-labelledby="hero-title">
  <HeroScene />
  <div class="relative z-2 mx-auto max-w-site-wide px-(--gutter) pb-12 lg:pt-24 lg:pb-32">
    <div class="lg:max-w-[min(660px,52%)]">
      <p
        class="hero-reveal reveal-1 text-[0.7rem] font-medium tracking-[0.24em] text-link uppercase lg:text-xs"
      >
        <PlaceholderText text={copy.eyebrow} />
      </p>
      <h1 id="hero-title" class="hero-title hero-rise mt-3 mb-4 font-bold tracking-[-0.02em] lg:mt-4.5 lg:mb-6">
        <span class="hero-title-lead block text-mint">{copy.title.lead}</span>
        {" "}
        <span class="hero-title-rest block font-semibold">{copy.title.rest}</span>
      </h1>
      <p class="hero-reveal reveal-3 max-w-[560px] text-[1.02rem] leading-[1.6] font-light text-muted lg:text-[1.15rem]">
        {copy.lead}
      </p>
      {
        actions.length > 0 && (
          <div class="hero-reveal reveal-4 mt-6.5 grid gap-3 lg:mt-8.5 lg:flex lg:gap-3.5">
            {actions.map(({ label, variant, href }) => (
              <Button href={href} variant={variant} icon={variant === "primary" ? "arrow" : undefined}>
                {label}
              </Button>
            ))}
          </div>
        )
      }
      <ul
        class="hero-reveal reveal-4 mt-9.5 hidden flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-muted lg:flex"
      >
        {
          copy.trust.map((item) => (
            <li class="hero-trust-item">
              <PlaceholderText text={item} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="absolute inset-x-0 bottom-7 z-2 hidden lg:block" aria-hidden="true">
    <p
      class="mx-auto flex max-w-site-wide items-center gap-3 px-(--gutter) text-xs tracking-[0.2em] text-muted uppercase"
    >
      <span class="hero-scroll-line"></span>
      {copy.scrollHint}
    </p>
  </div>
  <div class="hero-fade absolute inset-x-0 bottom-0 z-1 hidden h-[140px] lg:block"></div>
</section>

<style>
  /* The static dot grid behind the scene, fading out from the logo. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(var(--hero-dot) 1px, transparent 1.3px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 60% 70% at 70% 55%, #000 0, transparent 75%);
    opacity: 0.55;
    --hero-dot: rgb(157 189 204 / 0.16);
  }

  :global(:root[data-theme="light"]) .hero::before {
    --hero-dot: rgb(74 101 119 / 0.2);
  }

  /* The mockups' sizes: 38 and 30 px at 390 px wide, both 56 px at 1440 px. */
  .hero-title {
    line-height: 1.08;
  }

  .hero-title-lead {
    margin-bottom: 4px;
    font-size: clamp(2.375rem, 1.2rem + 2.6vw, 3.5rem);
  }

  .hero-title-rest {
    font-size: clamp(1.875rem, 0.6rem + 3.4vw, 3.5rem);
    line-height: 1.12;
  }

  @media (min-width: 64rem) {
    .hero-title {
      line-height: 1.06;
    }

    .hero-title-lead {
      margin-bottom: 6px;
    }

    .hero-title-rest {
      line-height: 1.06;
    }
  }

  /* The trust line's items, separated by small gold dots. */
  .hero-trust-item + .hero-trust-item::before {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
    vertical-align: middle;
  }

  .hero-scroll-line {
    display: block;
    width: 1px;
    height: 34px;
    background: linear-gradient(var(--grey), transparent);
  }

  .hero-fade {
    background: linear-gradient(transparent, var(--bg));
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-reveal {
      animation: hero-fade-up 0.5s var(--ease-out) var(--reveal-delay) both;
    }

    .hero-rise {
      animation: hero-rise 0.5s var(--ease-out) 0.2s both;
    }
  }

  .reveal-1 {
    --reveal-delay: 0.1s;
  }

  .reveal-3 {
    --reveal-delay: 0.3s;
  }

  .reveal-4 {
    --reveal-delay: 0.4s;
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* The heading only moves: it stays opaque, so it paints at once. */
  @keyframes hero-rise {
    from {
      transform: translateY(12px);
    }
  }
</style>
