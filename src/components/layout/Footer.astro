---
/**
 * The footer, in three columns from 1024 px and stacked on phones: the brand
 * (the horizontal logo, the tagline and the company line, its registration
 * read from src/content/company), the navigation (src/i18n/navigation.ts:
 * the main pages, the quiz and contact, each shown once its page exists), and
 * the site's measured Lighthouse scores. Then the copyright line and the link
 * to the legal notice, which French law requires on every page.
 */
import { translations } from "../../i18n";
import { companyFacts } from "../../i18n/content";
import { type FooterPage, footerLinks } from "../../i18n/navigation";
import { type PageRoute, pathOf } from "../../i18n/routes";
import Logo from "../brand/Logo.astro";
import SiteScores from "./SiteScores.astro";

interface Props {
  route: PageRoute;
}

const { route } = Astro.props;
const t = translations(route.locale).layout;
const company = await companyFacts();
const links = footerLinks(route);
const labels: Record<FooterPage, string> = { ...t.nav, quiz: t.quiz, contact: t.footer.contact };
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-site px-(--gutter) py-8 text-sm text-muted">
    <div class="footer-columns">
      <div class="footer-brand">
        <Logo class="-ml-2 h-16 w-auto" />
        <p>{t.footer.tagline}</p>
        <p>{t.footer.legalForm} {company.name} — {company.registration}</p>
      </div>
      <div class="footer-navigation">
        <p class="footer-title">{t.footer.navigationTitle}</p>
        <nav aria-label={t.footer.navigation}>
          <ul>
            {
              links.map((link) => (
                <li>
                  <a href={link.href} class="footer-nav-link" aria-current={link.current}>
                    {labels[link.page]}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <div class="footer-scores">
        <SiteScores />
      </div>
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-line pt-6">
      <p>© {year} Sekoya Solutions</p>
      <a href={pathOf("legal", route.locale)} class="footer-link hover:text-ink">{t.legalNotice}</a>
    </div>
  </div>
</footer>

<style>
  /* Stacked on phones; the brand and the navigation side by side from
     768 px, with the scores under them; three columns from 1024 px. */
  .footer-columns {
    display: grid;
    gap: 40px 48px;
    align-items: start;
  }

  @media (width >= 48rem) {
    .footer-columns {
      grid-template-columns: 1fr 1fr;
    }

    .footer-scores {
      grid-column: 1 / -1;
    }
  }

  @media (width >= 64rem) {
    .footer-columns {
      grid-template-columns: 1.2fr 1fr 1fr;
    }

    .footer-scores {
      grid-column: auto;
    }
  }

  .footer-brand {
    display: grid;
    gap: 8px;
    justify-items: start;
    max-width: 300px;
  }

  .footer-title {
    margin-bottom: 4px;
    color: var(--ink);
    font-weight: 600;
  }

  /* The links in two columns, read down the first, then the second, at
     every width: the column is then no taller than the measured scores, so
     the footer keeps its height, and the career page's pinned rings still
     end with the footer coming up under them. 36 px targets, above the
     24 px of WCAG 2.2. */
  .footer-navigation ul {
    columns: 2;
    column-gap: 24px;
  }

  .footer-navigation li {
    break-inside: avoid;
  }

  .footer-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer-nav-link:hover,
  .footer-nav-link[aria-current] {
    color: var(--ink);
  }

  .footer-nav-link[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--mint);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .footer-link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
