---
/**
 * The footer shell: the copyright line. Its columns (brand, navigation and
 * the measured Lighthouse scores) come with their own issues.
 */
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-site px-(--gutter) py-8 text-sm text-muted">
    <p>© {year} Sekoya Solutions</p>
  </div>
</footer>
